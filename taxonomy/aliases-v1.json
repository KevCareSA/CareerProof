  "known_traps": [
    {
      "trap": "inline_correction",
      "example": "INF3708 A3 — early prep started (mislogged as INF3705 A2 in the original report)",
      "rule": "When two course codes appear and one sits inside a parenthetical containing a retraction marker (mislogged, incorrect, should have been, actually), the parenthetical code is discarded."
    },
    {
      "trap": "duplicate_day_content",
      "example": "Days 76 and 77 (2026-07-04 and 2026-07-05) carry identical text.",
      "rule": "Identical content on distinct dates is legitimate. ContentHash alone must not deduplicate across differing Date values."
    },
    {
      "trap": "unreliable_tags",
      "example": "Days 82 and 83 tagged 'Hackathons' with no hackathon session present.",
      "rule": "Tags narrow the candidate set. Tags never decide a resolution on their own."
    },
    {
      "trap": "status_noise_in_session_text",
      "example": "SUBMITTED 3:34 PM, 1 day 16 hours early",
      "rule": "Timing and status commentary is stripped by the normaliser before skill resolution is attempted."
    }
  ]
